Options -MultiViews RewriteEngine On RewriteBase / # React Router support
RewriteCond %{REQUEST_FILENAME} !-f RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L] # Browser Caching
<IfModule mod_expires.c>
	ExpiresActive On ExpiresDefault "access plus 1 month" ExpiresByType image/webp
	"access plus 1 year" ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/jpg "access plus 1 year" ExpiresByType image/jpeg "access
	plus 1 year" ExpiresByType image/svg+xml "access plus 1 year" ExpiresByType
	text/css "access plus 1 month" ExpiresByType application/javascript "access
	plus 1 month"
</IfModule>

# GZIP Compression
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css
	AddOutputFilterByType DEFLATE application/javascript application/json
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
